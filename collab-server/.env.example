NODE_ENV=production
HOST=0.0.0.0
PORT=1234

# Use exact frontend origins in production, comma-separated if needed.
CORS_ALLOW_ORIGINS=https://codeduel.example.com

# Required in production. Use a long random value.
ROOM_TOKEN_SECRET=replace-with-a-long-random-secret

# Match the Cognito pool and client used by the frontend.
COGNITO_USER_POOL_ID=us-east-1_example
COGNITO_USER_POOL_CLIENT_ID=exampleclientid

# Persistence directory inside the container or host filesystem.
YDOCS_DIR=/data

PERSISTENCE_FLUSH_DEBOUNCE_MS=750
MAX_PAYLOAD_BYTES=16777216
PING_TIMEOUT_MS=30000
ROOM_TTL_MS=86400000
ROOM_ACCESS_TOKEN_TTL_MS=43200000
ROOM_SWEEP_INTERVAL_MS=60000
SHUTDOWN_GRACE_MS=15000
GC=true
